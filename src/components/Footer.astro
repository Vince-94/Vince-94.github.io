---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
	<p>&copy; {year} {site.name}. Built with Astro, hosted on GitHub Pages.</p>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--color-border);
		color: var(--color-text-muted);
		font-size: 0.85rem;
		text-align: center;
		padding: 1.5rem;
	}
</style>
